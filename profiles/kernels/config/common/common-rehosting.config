# FAT-authored generic rehosting capabilities. Machine and ABI constraints live
# in separate fragments so this file cannot silently define a device profile.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NET=y
CONFIG_PCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_JFFS2_FS=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# Router and gateway firmware puts its LAN ports behind a bridge and its
# segments behind VLANs. Without these the firmware's own init reports
# "br0: No such device", its network services never bind, and the box looks
# broken for a reason that has nothing to do with the firmware.
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_PRINTK=y
CONFIG_DEBUG_KERNEL=y
