{
  "name": "consumer-iot-camera",
  "prompt": "BK-IoT =>",
  "bootdelay": 3,
  "loadaddr": "0x80008000",
  "bootcmd": "run verify_sig; bootm ${loadaddr}",
  "bootargs": "console=ttyAMA0,115200 root=/dev/mmcblk0p2 rw",
  "verify": "yes",
  "sig_check": "yes",
  "recovery_mode": "0",
  "rollback_ctr": "5",
  "rollback_idx": "5",
  "qemu_binary": "qemu-system-arm",
  "qemu_machine": "virt"
}
